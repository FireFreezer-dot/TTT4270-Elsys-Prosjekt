#include <BLEDevice.h>
#include <BLEUtils.h>
#include <BLEScan.h>
#include <cmath>
#include <vector>
#include <numeric>
#include <HardwareSerial.h>

// --- KONFIGURASJON ---
#define MAX_SAMPLES 5

// --- UART ---
#define TXD2 16
#define RXD2 17
HardwareSerial mySerial(2);

//Brukes til utregning av avstand
const int MEASURED_POWER = -51;
const float N = 2.0;

const int SCAN_TIME = 2;
int max_distance = 20; //Maks avstand enheten kan ha fra scanneren før den bir fjernet
const unsigned long MAX_UNSEEN_MS = 10000; //Hvor lang tid det skal ta fra scanneren ikke finner enheten til den blir fjernet

// --- ENHETSOBJEKT ---
struct BLETarget {
  std::string serviceUUID;
  std::vector<int> rssiHistory;
  float avgRssi       = 0;
  float distance      = -1;
  bool seen           = false;
  bool pendingRemoval = false;
  unsigned long lastSeen = 0;

  BLETarget(const char* uuid) : serviceUUID(uuid) {}

  void addRssi(int rssi) {
    rssiHistory.push_back(rssi);
    if ((int)rssiHistory.size() > MAX_SAMPLES)
      rssiHistory.erase(rssiHistory.begin());

    float sum = std::accumulate(rssiHistory.begin(), rssiHistory.end(), 0);
    avgRssi   = sum / rssiHistory.size();
    distance  = pow(10, (float)(MEASURED_POWER - avgRssi) / (10 * N));
    seen      = true;
    lastSeen  = millis();
  }

  void print() const {
    Serial.printf("  UUID:       %s\n", serviceUUID.c_str());
    Serial.printf("  RSSI snitt: %.1f dBm (%d/%d målinger)\n",
      avgRssi, (int)rssiHistory.size(), MAX_SAMPLES);
    Serial.printf("  Avstand:    %.2f m\n", distance);
    Serial.printf("  Sist sett:  %lu ms siden\n", millis() - lastSeen);
  }
};

// --- ENHETSLISTE ---
std::vector<BLETarget> targets = {
  BLETarget("12345678-1234-1234-1234-123456789012"),
};

// --- BLE ---
BLEScan* pBLEScan;

// --- HJELPEFUNKSJONER ---
BLETarget* findTargetByUUID(const BLEUUID& uuid) {
  String u = uuid.toString().c_str();
  for (auto& t : targets) {
    if (u == t.serviceUUID.c_str()) return &t;
  }
  return nullptr;
}

//Markerer targets som ikke har blitt sett siden MAX_UNSEEN_MS
void markStaleTargets() {
  for (auto& t : targets) {
    if (t.seen && (millis() - t.lastSeen) > MAX_UNSEEN_MS) {
      Serial.println("Markerer som utgått: " + String(t.serviceUUID.c_str()));
      mySerial.println(t.serviceUUID.c_str());
      t.pendingRemoval = true;
    }
  }
}
//Fjerner enheten som er markert for fjerning
void removeMarkedTargets() {
  targets.erase(
    std::remove_if(targets.begin(), targets.end(), [](const BLETarget& t) {
      return t.pendingRemoval;
    }),
    targets.end()
  );
}

// --- BLE CALLBACK ---
class MyAdvertisedDeviceCallbacks : public BLEAdvertisedDeviceCallbacks {
  void onResult(BLEAdvertisedDevice advertisedDevice) {
    if (!advertisedDevice.haveServiceUUID()) return;

    //Henter enhet
    BLEUUID uuid = advertisedDevice.getServiceUUID();
    BLETarget* target = findTargetByUUID(uuid);
    if (target == nullptr) return;

    //henter og oppdaterer rssi
    int rssi = advertisedDevice.getRSSI();
    target->addRssi(rssi);

    //Skriver ut informasjon om enheten
    Serial.printf("[BLE] %s | RSSI=%d | Avstand=%.2f m\n",
      target->serviceUUID.c_str(), rssi, target->distance);

    //Markerer for fjerning hvis den er for langt unna
    if (target->distance >= max_distance) {
      mySerial.println(target->serviceUUID.c_str());
      Serial.println("Markerer for fjerning: " + String(target->serviceUUID.c_str()));
      Serial.println("Avstand: " + String(target->distance) + "Tid: " + String(target->lastSeen));
      target->pendingRemoval = true;
    }
  }
};

// --- SETUP ---
void setup() {
  Serial.begin(115200);
  delay(500);

  //Setter opp UART
  mySerial.begin(9600, SERIAL_8N1, RXD2, TXD2);
  Serial.println("ESP32 UART Distance Measurement");
  Serial.println("=== Avstandsmåler ESP32 (Service UUID-basert) ===");

  //Setter opp BLE
  BLEDevice::init("");
  pBLEScan = BLEDevice::getScan();
  pBLEScan->setAdvertisedDeviceCallbacks(new MyAdvertisedDeviceCallbacks());
  pBLEScan->setActiveScan(true);
  pBLEScan->setInterval(100);
  pBLEScan->setWindow(99);

  Serial.println("BLE klar");
  Serial.println("Starter skanning...\n");
}

void loop() {
  //Henter informasjon fra web-ESP
  if (mySerial.available()) {
    String sessionKey = mySerial.readStringUntil('\n');
    sessionKey.trim();
    targets.push_back(BLETarget(sessionKey.c_str()));
    Serial.println("Lagrer UUID: " + sessionKey);
    pBLEScan->stop();
    pBLEScan->clearResults();
  }

  //Starter BLE skann
  Serial.println("--- BLE skann ---");
  pBLEScan->start(SCAN_TIME, false);
  pBLEScan->clearResults();

  markStaleTargets();    // sjekker tid siden sist sett
  removeMarkedTargets(); // fjerner alle markerte

  //Skriver ut info om enheter
  Serial.println("\n=== STATUS ===");
  for (auto& t : targets) {
    if (t.seen) t.print();
  }

  delay(100);
}
