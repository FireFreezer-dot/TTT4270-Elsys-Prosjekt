#include <BLEDevice.h>
#include <BLEUtils.h>
#include <BLEScan.h>
#include <cmath>
#include <vector>
#include <numeric>
#include <string.h>

// --- KONFIGURASJON ---
#define MAX_TARGETS 10
#define MAX_NAME_LEN 32
#define MAX_SAMPLES 5

const int MEASURED_POWER = -51;
const float N = 2.0;
const int SCAN_TIME = 2;

// --- DATASTRUKTURER ---
typedef struct ble_result {
  char deviceName[MAX_NAME_LEN];
  float avgRssi;
  float distance;
  int sampleCount;
} ble_result;

// --- ENHETSOBJEKT ---
struct BLETarget {
  char name[MAX_NAME_LEN];
  std::vector<int> rssiHistory;
  float avgRssi    = 0;
  float distance   = -1;
  bool seen        = false;
  unsigned long lastSeen = 0;

  BLETarget() { name[0] = '\0'; }

  BLETarget(const char* n) {
    strncpy(name, n, MAX_NAME_LEN - 1);
    name[MAX_NAME_LEN - 1] = '\0';
  }

  void addRssi(int rssi) {
    rssiHistory.push_back(rssi);
    if ((int)rssiHistory.size() > MAX_SAMPLES)
      rssiHistory.erase(rssiHistory.begin());

    float sum = std::accumulate(rssiHistory.begin(), rssiHistory.end(), 0);
    avgRssi   = sum / rssiHistory.size();
    distance  = pow(10, (float)(MEASURED_POWER - avgRssi) / (10 * N));
    seen      = true;
    lastSeen  = millis();
  }

  void reset() {
    rssiHistory.clear();
    avgRssi  = 0;
    distance = -1;
    seen     = false;
    lastSeen = 0;
  }

  void print() const {
    Serial.printf("  Enhet:      %s\n", name);
    Serial.printf("  RSSI snitt: %.1f dBm (%d/%d målinger)\n",
      avgRssi, (int)rssiHistory.size(), MAX_SAMPLES);
    Serial.printf("  Avstand:    %.2f m\n", distance);
    Serial.printf("  Sist sett:  %lu ms siden\n", millis() - lastSeen);
  }

  ble_result toResult() const {
    ble_result r;
    strncpy(r.deviceName, name, MAX_NAME_LEN - 1);
    r.deviceName[MAX_NAME_LEN - 1] = '\0';
    r.avgRssi    = avgRssi;
    r.distance   = distance;
    r.sampleCount = rssiHistory.size();
    return r;
  }
};

// --- LISTE OVER TARGETS ---
BLETarget targets[MAX_TARGETS];
int targetCount = 3;

// --- BLE ---
BLEScan* pBLEScan;

// --- HJELPEFUNKSJONER ---
BLETarget* findTarget(const String& name) {
  for (int i = 0; i < targetCount; i++)
    if (name == String(targets[i].name)) return &targets[i];
  return nullptr;
}

void printAllTargets() {
  Serial.println("[TARGETS] Aktive målenheter:");
  for (int i = 0; i < targetCount; i++) {
    Serial.printf("  %d: %s%s\n", i + 1, targets[i].name,
      targets[i].seen ? " (sett)" : " (ikke sett enda)");
  }
}

// --- BLE CALLBACK ---
class MyAdvertisedDeviceCallbacks : public BLEAdvertisedDeviceCallbacks {
  void onResult(BLEAdvertisedDevice advertisedDevice) {
    if (!advertisedDevice.haveName()) return;
    String name = String(advertisedDevice.getName().c_str());

    BLETarget* target = findTarget(name);
    if (target == nullptr) return;

    int rssi = advertisedDevice.getRSSI();
    target->addRssi(rssi);

    Serial.printf("[BLE] Fant: %s | RSSI: %d dBm | Avstand: %.2f m\n",
      name.c_str(), rssi, target->distance);
  }
};


// --- SETUP ---
void setup() {
  Serial.begin(115200);
  delay(500);

  Serial.println("=== Avstandsmåler ESP32 (UART-versjon) ===");

  targets[0] = BLETarget("iPhone");
  targets[1] = BLETarget("Galaxy S24");
  targets[2] = BLETarget("MacBook");


  BLEDevice::init("");
  pBLEScan = BLEDevice::getScan();
  pBLEScan->setAdvertisedDeviceCallbacks(new MyAdvertisedDeviceCallbacks());
  pBLEScan->setActiveScan(true);
  pBLEScan->setInterval(100);
  pBLEScan->setWindow(99);

  Serial.println("BLE klar");
  printAllTargets();
  Serial.println("Starter skanning...\n");
}


// --- LOOP ---
void loop() {
  Serial.println("--- BLE skann ---");
  pBLEScan->start(SCAN_TIME, false);
  pBLEScan->clearResults();

  Serial.println("\n=== STATUS ===");
  for (int i = 0; i < targetCount; i++) {
    if (targets[i].seen) targets[i].print();
  }

  delay(1000);
}
