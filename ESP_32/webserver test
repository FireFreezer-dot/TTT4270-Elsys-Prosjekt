#include "esp_now.h"
#include "WiFi.h"
#include "WebServer.h"
#include <string.h>
#include <HardwareSerial.h>
#include "esp_wifi.h"
#include "SPIFFS.h"

#define TXD2 16
#define RXD2 17

#define EAP_IDENTITY "matstbo@stud.ntnu.no"
#define EAP_USERNAME "matstbo@stud.ntnu.no"
#define EAP_PASSWORD "Detsnørdetsnørtittelibom30"

#define MAX_TICKETS 100
#define MAX_MEASUREMENTS 300

// UART
HardwareSerial mySerial(2);

// WiFi
const char* ssid = "eduroam";
WebServer server(80);

// ---------- DATASTRUKTURER ----------

typedef struct {
  char ticketID[32];
  int amountCustomers;
  char sessionKey[40];
} struct_message;

typedef struct {
  bool success;
  unsigned long latencyMs;
} measurement_t;

// ---------- GLOBALE VARIABLER ----------

struct_message tickets[MAX_TICKETS];
measurement_t measurements[MAX_MEASUREMENTS];

int ticketCount = 0;
int passengerEver = 0;
int passengerNow = 0;
int measurementCount = 0;

// Latency-måling (KORREKT)
bool pendingMeasurement = false;
unsigned long measurementStartTime = 0;
bool lastMeasurementSuccess = false;

// ---------- HJELPEFUNKSJONER ----------

int findTicket(const char* id) {
  for (int i = 0; i < ticketCount; i++) {
    if (strcmp(tickets[i].sessionKey, id) == 0) {
      return i;
    }
  }
  return -1;
}

void fjernBillett(int index) {
  passengerNow -= tickets[index].amountCustomers;
  for (int i = index; i < ticketCount - 1; i++) {
    tickets[i] = tickets[i + 1];
  }
  ticketCount--;
}

void leggTilBillett(struct_message ticket) {
  tickets[ticketCount] = ticket;
  ticketCount++;
  passengerNow += ticket.amountCustomers;
  passengerEver += ticket.amountCustomers;
  mySerial.println(ticket.sessionKey);
}

// ---------- MÅLELOGGING ----------

void saveMeasurementsToFile() {
  File file = SPIFFS.open("/measurements.csv", FILE_WRITE);
  if (!file) {
    Serial.println("Kunne ikke åpne fil");
    return;
  }

  file.println("index,success,latency_ms");

  for (int i = 0; i < measurementCount; i++) {
    file.print(i);
    file.print(",");
    file.print(measurements[i].success ? "1" : "0");
    file.print(",");
    file.println(measurements[i].latencyMs);
  }

  file.close();
  Serial.println("Målinger lagret til SPIFFS (/measurements.csv)");
}

void logMeasurement(bool success, unsigned long startTime) {
  if (measurementCount >= MAX_MEASUREMENTS) return;

  measurements[measurementCount].success = success;
  measurements[measurementCount].latencyMs = millis() - startTime;
  measurementCount++;

  if (measurementCount == MAX_MEASUREMENTS) {
    saveMeasurementsToFile();
  }
}

// ---------- ESP-NOW CALLBACK ----------

void OnDataRecv(const esp_now_recv_info_t *info,
                const uint8_t *incomingData, int len) {

  measurementStartTime = millis();
  pendingMeasurement = true;

  bool success = false;

  struct_message newTicket;
  memcpy(&newTicket, incomingData, sizeof(newTicket));

  int indeks = findTicket(newTicket.sessionKey);

  if (indeks >= 0) {
    fjernBillett(indeks);
    success = true;
  } 
  else if (ticketCount < MAX_TICKETS) {
    leggTilBillett(newTicket);
    success = true;
  }

  lastMeasurementSuccess = success;
}

// ---------- WEBSIDE ----------

void passasjerDatabase() {

  // ⭐ HER MÅLES LATENCY RIKTIG ⭐
  if (pendingMeasurement) {
    logMeasurement(lastMeasurementSuccess, measurementStartTime);
    pendingMeasurement = false;
  }

  String html = "<!DOCTYPE html><html><head>";
  html += "<meta http-equiv='refresh' content='2'>";
  html += "<meta name='viewport' content='width=device-width, initial-scale=1'>";
  html += "<style>body{font-family:Arial}</style></head><body>";

  html += "<h1>Passenger Database</h1>";
  html += "<p>Passengers onboard: " + String(passengerNow) + "</p>";
  html += "<p>Total passengers ever: " + String(passengerEver) + "</p>";
  html += "<p>Measurements: " + String(measurementCount) + " / 300</p>";

  html += "<table border='1'><tr><th>Ticket ID</th><th>Passengers</th></tr>";
  for (int i = 0; i < ticketCount; i++) {
    html += "<tr><td>";
    html += tickets[i].ticketID;
    html += "</td><td>";
    html += String(tickets[i].amountCustomers);
    html += "</td></tr>";
  }
  html += "</table>";

  html += "<p><a href='/download'>Download measurements (CSV)</a></p>";

  html += "</body></html>";
  server.send(200, "text/html", html);
}

// ---------- LAST NED CSV ----------

void downloadMeasurements() {
  if (!SPIFFS.exists("/measurements.csv")) {
    server.send(404, "text/plain", "File not found");
    return;
  }

  File file = SPIFFS.open("/measurements.csv", FILE_READ);
  server.streamFile(file, "text/csv");
  file.close();
}

// ---------- SETUP ----------

void setup() {
  Serial.begin(115200);
  mySerial.begin(9600, SERIAL_8N1, RXD2, TXD2);

  if (!SPIFFS.begin(true)) {
    Serial.println("SPIFFS init feilet");
  }

  WiFi.mode(WIFI_STA);
  esp_wifi_set_channel(6, WIFI_SECOND_CHAN_NONE);

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW init feilet");
    return;
  }

  esp_now_register_recv_cb(OnDataRecv);

  WiFi.begin(ssid, WPA2_AUTH_PEAP,
             EAP_IDENTITY, EAP_USERNAME, EAP_PASSWORD);

  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.print(".");
  }

  Serial.println("\nWiFi tilkoblet");
  Serial.println(WiFi.localIP());

  server.on("/", passasjerDatabase);
  server.on("/download", downloadMeasurements);
  server.begin();

  Serial.println("Webserver startet");
}

// ---------- LOOP ----------

void loop() {
  if (mySerial.available()) {
    String receivedKey = mySerial.readStringUntil('\n');
    receivedKey.trim();

    for (int i = 0; i < ticketCount; i++) {
      if (receivedKey.equals(tickets[i].sessionKey)) {
        fjernBillett(i);
        break;
      }
    }
  }

  server.handleClient();
}
