void setup() {
  //Begynner serial monitor
  Serial.begin(115200);

  //UART setup 
  mySerial.begin(9600,SERIAL_8N1, RXD2, TXD2); 

  //Wifi-modus for å ta i mot ESP-NOW
  WiFi.mode(WIFI_STA);
  //esp_wifi_set_channel(6, WIFI_SECOND_CHAN_NONE);

  //Sjekker at ESP-NOW blir initialisert riktig
  if (esp_now_init() != ESP_OK) {
    Serial.println("Error initializing ESP-NOW");
    return;
  }

  //Registrerer callback-funksjonen
  esp_now_register_recv_cb(OnDataRecv);

  //Kobler til nett
  Serial.print("Connecting to ");
  Serial.println(ssid);
  //Serial.println(ssid_2);
  WiFi.begin(ssid, WPA2_AUTH_PEAP, EAP_IDENTITY, EAP_USERNAME, EAP_PASSWORD);  
  //WiFi.begin(ssid_2, password);

  //Printer så lenge internett ikke er koblet til
  while (WiFi.status() != WL_CONNECTED) {
    delay(2000);
    Serial.print(".");
  }

  //Ble brukt under testing
  Serial.println("");
  Serial.println("WiFi connected");

  Serial.print("WiFi channel: ");
  Serial.println(WiFi.channel()); 
  
  Serial.println("IP address: ");
  //Print the IP address
  Serial.println(WiFi.localIP());

  //Definerer hvilken callback funksjon som skal kjøres om serveren blir aksessert (passasjerDatabase)
  server.on("/", passasjerDatabase);
  //Starter serveren
  server.begin();
  //Printes om alle stegene før er blitt gjennomført riktig
  Serial.println("Web server started");
}

void loop() {
  //Dersom det blir lest en melding fra UART (sessionKey til mobilen som gikk ut av rekkevidde)
  if (mySerial.available()) {
    //Kopierer den mottatte meldingen
    String receivedKey = mySerial.readStringUntil('\n'); 
    //Trimmer vekk tomrom
    receivedKey.trim();
    //Brukt for testing
    //Serial.println(receivedKey);

    //Ser gjennom alle billetter i listen. Dersom sessionKey matcher mottatt melding --> samme funksjonalitet som linje 67-73
    for (int i = 0; i < ticketCount; ++i) {
      if (receivedKey.equals(tickets[i].sessionKey)) {
        fjernBillett(i);
        break;
      }
    }
  }
  server.handleClient();
}
