//Initialiserer samme struct som ESP_1 
typedef struct struct_message {
  char ticketID[32];
  int amountCustomers;
  char sessionKey[40];  
} struct_message;

//Initialiserer liste med billetter
struct_message tickets[MAX_TICKETS];

//Initialiserer variabler som skal vises på webserveren
int ticketCount = 0;
int passengerEver = 0;
int passengerNow = 0;

//Initialiserer funksjon for å finne index til en billett i listen
int findTicket(const char* id) {
  for (int i=0; i<ticketCount; i++) {
    if (strcmp(tickets[i].sessionKey,id)==0){
      return i;
    }
  }
  return -1;
}

//Funksjon for å fjerne en billett som finnes på indeksen index
void fjernBillett(int index) {
  Serial.println("Billett finnes allerede. Blir nå fjernet!");
  passengerNow -= tickets[index].amountCustomers;
  for (int i = index; i < ticketCount - 1; ++i) {
    tickets[i] = tickets[i+1];
  }
  ticketCount--;
}

//Funksjon for å legg til en ny unik billett
void leggTilBillett(struct_message ticket) {
  Serial.println("Billett blir lagt til!");
  tickets[ticketCount] = ticket;
  ticketCount++;
  passengerNow += ticket.amountCustomers;
  passengerEver += ticket.amountCustomers;
  mySerial.println(ticket.sessionKey);
}

//Callback funksjon som skal kjøre når ESP-NOW sending er mottatt
void OnDataRecv(const esp_now_recv_info_t *info, const uint8_t *incomingData, int len) {
  //Deklarerer en ny billett
  struct_message newTicket;

  //Kopierer den mottatte billetten
  memcpy(&newTicket, incomingData, sizeof(newTicket));

  //Bare for oversikt under testing
  Serial.println("Ticket ID: ");
  Serial.println(newTicket.ticketID);
  
  //Initialiserer index for ny billett (>=0 om finnes allerede, -1 om ny)
  int indeks = findTicket(newTicket.sessionKey);

  //Dersom billetten allerede finnes --> Noen scanner på nytt (går av fergen) --> minker antall passasjerer på fergen og fjerner billetten fra listen
  if (indeks >= 0) {
    fjernBillett(indeks);
  }
  //Billetten er unik --> Legger til billetten i listen, og øker passasjer-variablene
  else {
    if (ticketCount < MAX_TICKETS) {
      leggTilBillett(newTicket);
    }
  }
}

