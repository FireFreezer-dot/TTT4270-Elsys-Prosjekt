#include "esp_now.h"
#include "WiFi.h"
#include "WebServer.h"
#include <string.h>
#include <HardwareSerial.h>
#define TXD2 16
#define RXD2 17
#define EAP_IDENTITY "matstbo@stud.ntnu.no" //Ditt brukernavn (som nevnt over)
#define EAP_USERNAME "matstbo@stud.ntnu.no" //Ofte det samme som identity
#define EAP_PASSWORD "Detsnørdetsnørtittelibom30" //Ditt Feide-passord
#define MAX_TICKETS 100 //Maksimal mengde billetter i databasen (webserver)

//UART-setup
HardwareSerial mySerial(2);

//Definerer sessionKey som skal sendes 
String sessionKey = "";

//Definerer navn på nettverk
const char* ssid = "eduroam";

//Initialiserer server til port 80
WebServer server(80);

//Definerer samme struct som ESP_1 
typedef struct struct_message {
  char ticketID[32];
  int amountCustomers;
  char customerName[32];
  char sessionKey[40];  
} struct_message;

//Initialiserer liste med billetter
struct_message tickets[MAX_TICKETS];

//Definerer variabler som skal vises på webserveren
int ticketCount = 0;
int passengerEver = 0;
int passengerNow = 0;

//Definerer funksjon for å finne index til en billett i listen
int findTicket(const char* id) {
  for (int i=0; i<ticketCount; i++) {
    if (strcmp(tickets[i].sessionKey,id)==0){
      return i;
    }
  }
  return -1;
}

//Funksjon for å fjerne en billett som finnes på indeksen index
void fjernBillett(int index) {
  Serial.println("Billett finnes allerede. Blir nå fjernet!");
  passengerNow -= tickets[index].amountCustomers;
  for (int i = index; i < ticketCount - 1; ++i) {
    tickets[i] = tickets[i+1];
  }
  ticketCount--;
}

//Funksjon for å legg til en ny unik billett
void leggTilBillett(struct_message ticket) {
  Serial.println("Billett blir lagt til!");
  tickets[ticketCount] = ticket;
  ticketCount++;
  passengerNow += ticket.amountCustomers;
  passengerEver += ticket.amountCustomers;
  mySerial.println(ticket.sessionKey);
}

//Definerer callback funksjon som skal kjøre når ESP-NOW sending er mottatt
void OnDataRecv(const esp_now_recv_info_t *info, const uint8_t *incomingData, int len) {
  //initialiserer en ny billett
  struct_message newTicket;

  //Kopierer den mottatte billetten
  memcpy(&newTicket, incomingData, sizeof(newTicket));

  //Bare for oversikt under testing
  Serial.println("Ticket ID: ");
  Serial.println(newTicket.ticketID);
  
  //Definerer index for ny billett (>=0 om finnes allerede, -1 om ny)
  int indeks = findTicket(newTicket.sessionKey);

  //dersom billetten allerede finnes --> Noen scanner på nytt (går av fergen) --> minker antall passasjerer på fergen og fjerner billetten fra listen
  if (indeks >= 0) {
    fjernBillett(indeks);
  }
  //Billetten er unik --> Legger til billetten i listen, og øker passasjer-variablene
  else {
    if (ticketCount < MAX_TICKETS) {
      leggTilBillett(newTicket);
    }
  }
}

//Definerer callback funksjon for formatering av nettside
void passasjerDatabase(){

  String html = "<!DOCTYPE html><html>";

  html += "<head>";
  html += "<title>Boat Passenger Database</title>";
  html += "<meta http-equiv='refresh' content='2'>";
  html += "</head>";

  html += "<body style='font-family:Arial'>";

  html += "<h1>Passenger Database</h1>";

  html += "<table border='1' style='border-collapse:collapse'>";

  html += "<tr>";
  html += "<th>Ticket ID</th>";
  html += "<th>Name</th>";
  html += "<th>Passengers</th>";
  html += "</tr>";

  for(int i=0;i<ticketCount;i++){

    html += "<tr>";

    html += "<td>";
    html += tickets[i].ticketID;
    html += "</td>";

    html += "<td>";
    html += tickets[i].customerName;
    html += "</td>";

    html += "<td>";
    html += String(tickets[i].amountCustomers);
    html += "</td>";

    html += "</tr>";

  }

  html += "</table>";

  html += "<h2>Total passengers now: ";
  html += String(passengerNow);
  html += "</h2>";

  html += "<h2>Total passengers ever: ";
  html += String(passengerEver);
  html += "</h2>";

  html += "</body></html>";

  //Sender alt over til webserveren
  server.send(200,"text/html",html);
}

void setup() {
  //Begynner serial monitor
  Serial.begin(115200);

  //UART setup 
  mySerial.begin(9600,SERIAL_8N1, RXD2, TXD2); 

  //Wifi-modus for å ta i mot ESP-NOW
  WiFi.mode(WIFI_STA);

  //Sjekker at ESP-NOW blir initialisert riktig
  if (esp_now_init() != ESP_OK) {
    Serial.println("Error initializing ESP-NOW");
    return;
  }

  //Registrerer callback-funksjonen
  esp_now_register_recv_cb(OnDataRecv);

  //Kobler til nett
  Serial.print("Connecting to ");
  Serial.println(ssid);
  WiFi.begin(ssid, WPA2_AUTH_PEAP, EAP_IDENTITY, EAP_USERNAME, EAP_PASSWORD);  
  //WiFi.begin(ssid_2, password);

  //Printer så lenge internett ikke er koblet til
  while (WiFi.status() != WL_CONNECTED) {
    delay(2000);
    Serial.print(".");
  }

  //Ble brukt under testing
  Serial.println("");
  Serial.println("WiFi connected");

  Serial.print("WiFi channel: ");
  Serial.println(WiFi.channel()); 
  
  Serial.println("IP address: ");
  //Print the IP address
  Serial.println(WiFi.localIP());

  //Definerer hvilken callback funksjon som skal kjøres om serveren blir aksessert (passasjerDatabase)
  server.on("/", passasjerDatabase);
  //Starter serveren
  server.begin();
  //Printes om alle stegene før er blitt gjennomført riktig
  Serial.println("Web server started");
}

void loop() {
  //Dersom det blir lest en melding fra UART (sessionKey til mobilen som gikk ut av rekkevidde)
  if (mySerial.available()) {
    //Kopierer den mottatte meldingen
    String receivedKey = mySerial.readStringUntil('\n'); 
    //Trimmer vekk tomrom
    receivedKey.trim();
    //Brukt for testing
    //Serial.println(receivedKey);

    //Ser gjennom alle billetter i listen. Dersom sessionKey matcher mottatt melding --> samme funksjonalitet som linje 67-73
    for (int i = 0; i < ticketCount; ++i) {
      if (receivedKey.equals(tickets[i].sessionKey)) {
        fjernBillett(i);
        break;
      }
    }
  }
  server.handleClient();
}
